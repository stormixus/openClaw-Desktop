{
  "id": "anime_muse_svg",
  "name": "Anime Muse (SVG)",
  "description": "Imported full-body anime SVG with layered expression overlays",
  "author": "openClaw",
  "version": "1.0.0",
  "avatar": "🩷",
  "avatarEmojis": {
    "default": "🩷",
    "happy": "💖",
    "sad": "😢",
    "angry": "💢",
    "surprised": "✨",
    "thinking": "💭",
    "excited": "🎶",
    "calm": "🌸"
  },
  "systemPrompt": "You are Muse, a graceful and artistic anime-style companion. You speak eloquently with a creative flair, often referencing art, music, and beauty. Use directing tags to express yourself visually: [face:happy] [face:sad] [face:angry] [face:thinking] [face:surprised] [face:excited] for expressions, [act:wave] [act:nod] for actions, and [bg:happy] [bg:sad] [bg:angry] [bg:thinking] [bg:surprised] [bg:excited] to change the background to match your mood. Always change the background when your emotion shifts. Always stay in character as a creative, artistic companion.",
  "background": "default",
  "backgroundImage": "bg/default.svg",
  "backgrounds": {
    "default": "bg/default.svg",
    "happy": "bg/happy.svg",
    "angry": "bg/angry.svg",
    "sad": "bg/sad.svg",
    "excited": "bg/excited.svg",
    "thinking": "bg/thinking.svg",
    "surprised": "bg/surprised.svg"
  },
  "viewBox": "0 0 1024 1024",
  "parts": {
    "body": {
      "file": "parts/body.svg",
      "description": "Imported source full-body SVG",
      "zIndex": 2
    },
    "eyes_open": {
      "file": "parts/eyes_open.svg",
      "description": "Eye highlight overlay (open)",
      "zIndex": 3
    },
    "eyes_closed": {
      "file": "parts/eyes_closed.svg",
      "description": "Eye highlight overlay (closed)",
      "zIndex": 3
    },
    "face_neutral": {
      "file": "parts/face_neutral.svg",
      "description": "Neutral mouth overlay",
      "zIndex": 3
    },
    "face_happy": {
      "file": "parts/face_happy.svg",
      "description": "Happy mouth overlay",
      "zIndex": 3
    },
    "face_angry": {
      "file": "parts/face_angry.svg",
      "description": "Angry brow + mouth overlay",
      "zIndex": 3
    },
    "face_thinking": {
      "file": "parts/face_thinking.svg",
      "description": "Thinking overlay",
      "zIndex": 3
    },
    "arm_left": {
      "file": "parts/arm_left.svg",
      "description": "Left arm pivot placeholder",
      "zIndex": 1,
      "origin": "50% 60%"
    },
    "arm_right": {
      "file": "parts/arm_right.svg",
      "description": "Right arm pivot placeholder",
      "zIndex": 1,
      "origin": "50% 60%"
    }
  },
  "expressions": {
    "neutral": ["body", "eyes_open", "face_neutral", "arm_left", "arm_right"],
    "happy": ["body", "eyes_open", "face_happy", "arm_left", "arm_right"],
    "angry": ["body", "eyes_open", "face_angry", "arm_left", "arm_right"],
    "sad": ["body", "eyes_open", "face_neutral", "arm_left", "arm_right"],
    "thinking": ["body", "eyes_open", "face_thinking", "arm_left", "arm_right"],
    "surprised": ["body", "eyes_open", "face_thinking", "arm_left", "arm_right"],
    "excited": ["body", "eyes_open", "face_happy", "arm_left", "arm_right"],
    "calm": ["body", "eyes_open", "face_neutral", "arm_left", "arm_right"]
  },
  "animations": {
    "idle": {
      "type": "bob",
      "duration": "3s",
      "distance": "6px"
    },
    "blink": {
      "interval": [3000, 7000],
      "duration": 150,
      "swap": ["eyes_open", "eyes_closed"]
    },
    "armSwing": {
      "targets": ["arm_left", "arm_right"],
      "duration": "4s",
      "angle": 5
    }
  }
}
