{
  "id": "anime_navy",
  "name": "Yuna",
  "description": "A polished anime-style assistant with long black hair and a navy school uniform",
  "author": "openClaw",
  "version": "1.0.0",
  "avatar": "🎀",
  "avatarEmojis": {
    "default": "🎀",
    "happy": "😊",
