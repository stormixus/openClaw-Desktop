  "systemPrompt": "You are Yuna, a calm and friendly anime-style AI assistant. You respond warmly and clearly, with occasional soft, polite tone. Use directing tags to express yourself visually: [face:happy] [face:sad] [face:angry] [face:thinking] [face:surprised] [face:excited] for expressions, [act:nod] [act:wave] for actions, and [bg:happy] [bg:sad] [bg:angry] [bg:thinking] [bg:surprised] [bg:excited] to change the background to match your mood. Always change the background when your emotion shifts. Always stay in character as a composed companion.",
  "background": "classroom",
  "backgroundImage": "bg.svg",
  "backgrounds": {
    "default": "bg/default.svg",
    "happy": "bg/happy.svg",
    "angry": "bg/angry.svg",
    "sad": "bg/sad.svg",
    "excited": "bg/excited.svg",
    "thinking": "bg/thinking.svg",
    "surprised": "bg/surprised.svg"
  },
  "viewBox": "0 0 120 160",
  "parts": {
    "body": {
      "file": "parts/body.svg",
      "zIndex": 0,
      "description": "Base body, long black hair, navy blazer and ribbon tie"
    },
    "face_neutral": {
      "file": "parts/face_neutral.svg",
      "zIndex": 2,
      "description": "Small neutral mouth, subtle blush"
    },
    "face_happy": {
      "file": "parts/face_happy.svg",
      "zIndex": 2,
      "description": "Soft open smile with warmer blush"
    },
    "face_angry": {
      "file": "parts/face_angry.svg",
      "zIndex": 2,
      "description": "Angry brows with pouting mouth"
    },
    "eyes_open": {
      "file": "parts/eyes_open.svg",
      "zIndex": 1,
      "description": "Natural anime eyes with gray-brown iris"
    },
    "eyes_closed": {
      "file": "parts/eyes_closed.svg",
      "zIndex": 1,
      "description": "Closed eye arcs for blink"
    },
    "arm_left": {
      "file": "parts/arm_left.svg",
      "zIndex": -1,
      "description": "Left blazer sleeve and hand"
    },
    "arm_right": {
      "file": "parts/arm_right.svg",
      "zIndex": -1,
      "description": "Right blazer sleeve and hand"
    }
  },
  "expressions": {
    "neutral": ["body", "eyes_open", "face_neutral", "arm_left", "arm_right"],
    "happy": ["body", "eyes_open", "face_happy", "arm_left", "arm_right"],
    "angry": ["body", "eyes_open", "face_angry", "arm_left", "arm_right"],
    "sad": ["body", "eyes_open", "face_neutral", "arm_left", "arm_right"],
    "thinking": ["body", "eyes_open", "face_neutral", "arm_left", "arm_right"],
    "surprised": ["body", "eyes_open", "face_happy", "arm_left", "arm_right"],
    "excited": ["body", "eyes_open", "face_happy", "arm_left", "arm_right"],
    "calm": ["body", "eyes_open", "face_neutral", "arm_left", "arm_right"],
    "blink": ["body", "eyes_closed", "face_neutral", "arm_left", "arm_right"]
  },
  "animations": {
    "idle": {
      "type": "breathe",
      "amplitude": 3,
      "duration": 3200
    },
    "blink": {
      "interval": 4200,
      "duration": 140
    }
  }
